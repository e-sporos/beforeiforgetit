{
  "name": "logistis",
  "version": "0.1.0",
  "description": "An MCP server that acts as a bookkeeper for a one-person business: tracks statutory deadlines, invoices, expenses and tax estimates, and watches for rule changes. Ships with a Greek (AADE / e-EFKA) jurisdiction pack.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "logistis": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "jurisdictions",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "node --test dist/test/*.test.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "accounting",
    "bookkeeping",
    "tax",
    "greece",
    "aade",
    "mydata",
    "freelancer"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
